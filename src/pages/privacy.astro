---
import Base from '../layouts/Base.astro';
import { getEntry, render } from 'astro:content';

const entry = await getEntry('pages', 'privacy');
if (!entry) throw new Error('The privacy page content is missing.');

const { Content } = await render(entry);
---

<Base title="Privacy" description={entry.data.description}>
  <section class="wrap max-w-3xl py-14 sm:py-20">
    <p class="eyebrow">Privacy</p>
    <h1 class="title mt-5">Privacy, in plain words.</h1>
    <p class="lede mt-5">
      Nothing leaves your machine unless you ask it to. The rest of this page is the detail: every
      request the app can make, every file it writes, and what this website does.
    </p>

    <div class="prose mt-10">
      <Content />
    </div>

    <p class="mono mt-12 border-t border-line pt-6 text-xs text-muted">
      If anything here is unclear, ask in the
      <a class="link" href="https://github.com/IAM-GROOT1/ctrlz/issues">
        issue tracker
      </a>
      .
    </p>
  </section>
</Base>
