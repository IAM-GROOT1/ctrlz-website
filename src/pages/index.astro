---
import Base from '../layouts/Base.astro';
import DownloadCta from '../components/DownloadCta.astro';
import Screenshot from '../components/Screenshot.astro';
import Faq from '../components/Faq.astro';
import {
  apps,
  browsers,
  catalog,
  faqHeading,
  hero,
  howItWorks,
  openSource,
  portableProfiles,
  resumable,
  screenshotSlots,
} from '../data/home';
import { site } from '../data/site';
import { version } from '../lib/releases';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: site.name,
  url: site.url,
  description: site.description,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Windows 10, Windows 11',
  isAccessibleForFree: true,
  license: 'https://opensource.org/license/mit',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  sameAs: [site.repo],
  ...(version
    ? {
        softwareVersion: version.version,
        downloadUrl: version.installer?.url ?? site.releases,
      }
    : {}),
};
---

<Base>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <!-- Hero ------------------------------------------------------------------>
  <section class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0 -z-10"
      style="background: radial-gradient(62% 52% at 74% 4%, rgba(206, 82, 40, 0.11), transparent 68%)"
      aria-hidden="true"
    ></div>

    <div class="wrap grid gap-12 pt-12 pb-16 lg:grid-cols-12 lg:items-center lg:gap-10 lg:pt-20 lg:pb-24">
      <div class="lg:col-span-5">
        <p class="eyebrow flex items-center gap-2.5">
          <span class="inline-block size-1.5 rounded-full bg-accent" aria-hidden="true"></span>
          {hero.eyebrow}
        </p>

        <h1 class="display mt-6">
          {hero.titleLead}
          <br />
          <em class="italic text-accent">{hero.titleEmphasis}</em>.
        </h1>

        <p class="lede mt-6 max-w-md">{hero.lede}</p>

        <div class="mt-9">
          <DownloadCta />
        </div>

        <div class="mt-8 flex flex-wrap items-center gap-x-4 gap-y-2">
          <a
            href={hero.secondaryCta.href}
            class="group inline-flex items-center gap-1.5 text-sm text-muted transition-colors hover:text-ink"
          >
            {hero.secondaryCta.label}
            <span
              class="transition-transform duration-200 group-hover:translate-y-0.5"
              aria-hidden="true"
            >
              <svg
                viewBox="0 0 16 16"
                class="size-3.5"
                fill="none"
                stroke="currentColor"
                stroke-width="1.4"
              >
                <path
                  d="M8 3v9M4.5 8.5 8 12l3.5-3.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                ></path>
              </svg>
            </span>
          </a>
        </div>

        <ul class="mt-10 flex flex-wrap items-center gap-x-3 gap-y-2 text-xs text-muted">
          {hero.facts.map((fact, index) => (
            <li class="flex items-center gap-3">
              {index > 0 && (
                <span class="hidden text-line sm:inline" aria-hidden="true">
                  /
                </span>
              )}
              {fact}
            </li>
          ))}
        </ul>
      </div>

      <div class="lg:col-span-7 lg:pl-4">
        <Screenshot
          name={screenshotSlots[0].name}
          label={screenshotSlots[0].label}
          alt={screenshotSlots[0].alt}
          width={screenshotSlots[0].width}
          height={screenshotSlots[0].height}
          theme={screenshotSlots[0].theme}
          priority
          sizes="(min-width: 1280px) 700px, (min-width: 1024px) 58vw, 100vw"
        />
      </div>
    </div>
  </section>

  <!-- How it works ---------------------------------------------------------->
  <section id="how" class="section rule">
    <div class="wrap">
      <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-5">
          <p class="eyebrow">{howItWorks.eyebrow}</p>
          <h2 class="title mt-5">{howItWorks.title}</h2>
        </div>
        <div class="lg:col-span-6 lg:col-start-7">
          <p class="lede max-w-xl">{howItWorks.intro}</p>
        </div>
      </div>

      <ol class="mt-14 grid border-t border-l border-line sm:grid-cols-2 lg:grid-cols-4">
        {howItWorks.steps.map((step, index) => (
          <li
            class="group border-r border-b border-line p-6 transition-colors duration-300 hover:bg-surface lg:p-7"
            data-reveal
            style={`--reveal-delay: ${index * 70}ms`}
          >
            <span class="mono text-accent">{step.number}</span>
            <h3 class="mt-6 font-serif text-[1.625rem] leading-none tracking-tight">
              {step.title}
            </h3>
            <p class="mt-4 text-sm leading-relaxed text-muted">{step.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- App sources ----------------------------------------------------------->
  <section id="features" class="section rule">
    <div class="wrap grid gap-12 lg:grid-cols-12 lg:items-center lg:gap-16">
      <div class="lg:col-span-5" data-reveal>
        <p class="eyebrow">{apps.eyebrow}</p>
        <h2 class="title mt-5">{apps.title}</h2>
        <p class="lede mt-5 max-w-md">{apps.body}</p>

        <ul class="mt-9 grid gap-6">
          {apps.points.map((point) => (
            <li class="border-t border-line pt-4">
              <p class="text-sm font-semibold">{point.title}</p>
              <p class="mt-1.5 text-sm leading-relaxed text-muted">{point.body}</p>
            </li>
          ))}
        </ul>
      </div>

      <div class="lg:col-span-6 lg:col-start-7" data-reveal style="--reveal-delay: 120ms">
        <Screenshot
          name={apps.screenshot.name}
          label={apps.screenshot.label}
          alt={apps.screenshot.alt}
          width={apps.screenshot.width}
          height={apps.screenshot.height}
          theme={apps.screenshot.theme}
          sizes="(min-width: 1024px) 560px, 100vw"
        />
      </div>
    </div>
  </section>

  <!-- Catalogue ------------------------------------------------------------->
  <section class="section rule">
    <div class="wrap grid gap-8 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-8">
        <p class="eyebrow">{catalog.eyebrow}</p>
        <h2 class="mt-5 max-w-2xl font-serif text-[clamp(2.2rem,1.2rem+3.4vw,4rem)] leading-[1] tracking-[-0.02em]">
          {catalog.title}
        </h2>
      </div>
      <div class="lg:col-span-4">
        <p class="text-[0.9375rem] leading-relaxed text-muted">{catalog.body}</p>
        <a
          href={catalog.link.href}
          class="group mt-6 inline-flex items-center gap-2 text-sm font-medium"
        >
          {catalog.link.label}
          <svg
            viewBox="0 0 16 16"
            class="size-3.5 transition-transform duration-200 group-hover:translate-x-1"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            aria-hidden="true"
          >
            <path
              d="M3 8h9M8.5 4.5 12 8l-3.5 3.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            ></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Browser backup -------------------------------------------------------->
  <section id="browsers" class="section border-y border-line bg-surface">
    <div class="wrap grid gap-12 lg:grid-cols-12 lg:items-center lg:gap-16">
      <div class="order-2 lg:order-1 lg:col-span-7" data-reveal>
        <Screenshot
          name={browsers.screenshot.name}
          label={browsers.screenshot.label}
          alt={browsers.screenshot.alt}
          width={browsers.screenshot.width}
          height={browsers.screenshot.height}
          theme={browsers.screenshot.theme}
          sizes="(min-width: 1280px) 640px, (min-width: 1024px) 56vw, 100vw"
        />
      </div>

      <div class="order-1 lg:order-2 lg:col-span-5" data-reveal style="--reveal-delay: 100ms">
        <p class="eyebrow">{browsers.eyebrow}</p>
        <h2 class="title mt-5">{browsers.title}</h2>
        <p class="lede mt-5 max-w-md">{browsers.body}</p>

        <ul class="mt-8 grid grid-cols-1 gap-x-6 gap-y-2.5 text-sm sm:grid-cols-2">
          {browsers.points.map((point) => (
            <li class="flex items-start gap-2.5 text-muted">
              <span class="mt-2 h-px w-3 shrink-0 bg-accent" aria-hidden="true" />
              {point}
            </li>
          ))}
        </ul>

        <aside class="mt-9 border-l-2 border-accent pl-5">
          <p class="text-sm font-semibold text-ink">{browsers.exclusions.title}</p>
          <p class="mt-2 text-sm leading-relaxed text-muted">{browsers.exclusions.body}</p>
        </aside>
      </div>
    </div>
  </section>

  <!-- Resumable installs + readable profiles -------------------------------->
  <section class="section rule">
    <div class="wrap grid gap-14 lg:grid-cols-2 lg:gap-16">
      <div data-reveal>
        <p class="eyebrow">{resumable.eyebrow}</p>
        <h2 class="title mt-5 max-w-sm">{resumable.title}</h2>
        <p class="lede mt-5 max-w-md">{resumable.body}</p>

        <div class="mt-10">
          <Screenshot
            name={resumable.screenshot.name}
            label={resumable.screenshot.label}
            alt={resumable.screenshot.alt}
            width={resumable.screenshot.width}
            height={resumable.screenshot.height}
            theme={resumable.screenshot.theme}
            sizes="(min-width: 1024px) 520px, 100vw"
          />
        </div>
      </div>

      <div class="lg:pt-24" data-reveal style="--reveal-delay: 100ms">
        <p class="eyebrow">{portableProfiles.eyebrow}</p>
        <h2 class="title mt-5 max-w-sm">{portableProfiles.title}</h2>
        <p class="lede mt-5 max-w-md">{portableProfiles.body}</p>

        <div class="mt-8 overflow-hidden rounded-lg border border-line bg-surface">
          <div class="flex items-center justify-between border-b border-line px-4 py-2.5">
            <span class="mono text-xs text-muted">work-pc.json</span>
            <span class="mono text-[0.625rem] tracking-[0.16em] text-muted">JSON</span>
          </div>
          <pre class="overflow-x-auto p-4 font-mono text-[0.75rem] leading-[1.7] text-ink"><code>{portableProfiles.snippet}</code></pre>
        </div>
      </div>
    </div>
  </section>

  <!-- Open source ----------------------------------------------------------->
  <section class="bg-band text-band-ink">
    <div class="wrap grid gap-10 py-20 lg:grid-cols-12 lg:items-end lg:py-24">
      <div class="lg:col-span-7">
        <p class="eyebrow" style="color: var(--c-band-muted)">
          {openSource.eyebrow}
        </p>
        <h2 class="title mt-5 max-w-xl">{openSource.title}</h2>
        <p
          class="mt-5 max-w-xl text-[0.9375rem] leading-relaxed"
          style="color: var(--c-band-muted)"
        >
          {openSource.body}
        </p>
      </div>

      <div class="flex flex-col items-start gap-4 lg:col-span-4 lg:col-start-9">
        <a
          href={site.repo}
          class="inline-flex items-center gap-2 rounded-md border px-4 py-2.5 text-sm font-medium transition-colors hover:bg-white/5"
          style="border-color: var(--c-band-line)"
        >
          Read the source
          <svg
            viewBox="0 0 16 16"
            class="size-3.5"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            aria-hidden="true"
          >
            <path
              d="M3 8h9M8.5 4.5 12 8l-3.5 3.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            ></path>
          </svg>
        </a>
        <p class="mono text-xs" style="color: var(--c-band-muted)">
          {openSource.repo} · MIT
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ ------------------------------------------------------------------->
  <section id="faq" class="section">
    <div class="wrap grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <p class="eyebrow">{faqHeading.eyebrow}</p>
        <h2 class="title mt-5">{faqHeading.title}</h2>
        <p class="mt-5 max-w-xs text-sm text-muted">
          Something unanswered?{' '}
          <a class="link" href={site.issues} rel="noopener noreferrer" target="_blank">
            Open an issue
          </a>
          .
        </p>
      </div>
      <div class="lg:col-span-7 lg:col-start-6">
        <Faq />
      </div>
    </div>
  </section>

  <!-- Closing call to action ------------------------------------------------>
  <section class="border-t border-line">
    <div class="wrap flex flex-col items-start justify-between gap-8 py-14 sm:flex-row sm:items-center">
      <div>
        <p class="eyebrow">Next</p>
        <p class="mt-3 font-serif text-[1.75rem] leading-tight tracking-tight sm:text-[2.125rem]">
          Windows is installed. Now the rest.
        </p>
      </div>
      <DownloadCta />
    </div>
  </section>
</Base>
