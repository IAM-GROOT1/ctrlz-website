---
import { Image } from 'astro:assets';
import mark from '../assets/brand/mark-1024.png';
import ThemeToggle from './ThemeToggle.astro';
import { nav, site } from '../data/site';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="sticky top-0 z-50 border-b border-line bg-canvas">
  <div class="wrap flex h-16 items-center gap-4">
    <a href="/" class="group flex items-center gap-2.5" aria-label={`${site.name} — home`}>
      <Image
        src={mark}
        alt=""
        width={28}
        height={28}
        class="size-7 rounded-[7px] transition-transform duration-200 ease-out group-hover:-rotate-3"
      />
      <span class="text-[0.9375rem] font-semibold tracking-[0.01em]">{site.name}</span>
    </a>

    <nav class="ml-6 hidden items-center gap-7 md:flex" aria-label="Main">
      {nav.map((item) => (
        <a
          href={item.href}
          class="nav-link"
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="ml-auto flex items-center gap-1.5">
      <a
        href={site.repo}
        class="hidden size-9 items-center justify-center rounded-md text-muted transition-colors hover:bg-surface hover:text-ink sm:flex"
        aria-label="CTRL+Z on GitHub"
      >
        <svg viewBox="0 0 16 16" class="size-[18px]" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path>
        </svg>
      </a>

      <ThemeToggle />

      <a href="/download" class="btn btn-accent ml-1.5 hidden px-4 py-2.5 text-sm sm:inline-flex">
        Download
      </a>

      <button
        id="menu-button"
        type="button"
        class="flex size-9 items-center justify-center rounded-md text-ink transition-colors hover:bg-surface md:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
      >
        <svg
          viewBox="0 0 20 20"
          class="size-5"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <path d="M3 6h14M3 10h14M3 14h14" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-line bg-canvas md:hidden">
    <nav class="wrap flex flex-col py-3" aria-label="Mobile">
      {nav.map((item) => (
        <a
          href={item.href}
          class="rounded-md px-2 py-2.5 text-[0.9375rem] text-ink transition-colors hover:bg-surface"
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
      <a
        href={site.repo}
        class="rounded-md px-2 py-2.5 text-[0.9375rem] text-muted transition-colors hover:bg-surface hover:text-ink"
      >
        Source code
      </a>
      <a href="/download" class="btn btn-accent mt-2">
        Download for Windows
      </a>
    </nav>
  </div>
</header>

<script>
  const button = document.getElementById('menu-button');
  const menu = document.getElementById('mobile-menu');

  if (button && menu) {
    const setOpen = (open: boolean) => {
      button.setAttribute('aria-expanded', String(open));
      button.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      menu.classList.toggle('hidden', !open);
    };

    button.addEventListener('click', () => {
      setOpen(button.getAttribute('aria-expanded') !== 'true');
    });

    menu.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && button.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        button.focus();
      }
    });

    window.matchMedia('(min-width: 768px)').addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>
