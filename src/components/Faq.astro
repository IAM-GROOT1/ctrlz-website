---
import { faq } from '../data/faq';
---

<div class="border-t border-line">
  {faq.map((item) => (
    <details class="group border-b border-line">
      <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-6 [&::-webkit-details-marker]:hidden">
        <h3 class="max-w-2xl text-[1.0625rem] font-semibold leading-snug tracking-[-0.01em] text-ink">
          {item.question}
        </h3>
        <span
          class="faq-icon mt-0.5 inline-flex size-6 shrink-0 items-center justify-center rounded-full border border-line text-muted transition-colors group-hover:border-ink/30 group-hover:text-ink"
          aria-hidden="true"
        >
          <svg
            viewBox="0 0 12 12"
            class="size-3"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
          >
            <path d="M6 1.5v9M1.5 6h9" stroke-linecap="round"></path>
          </svg>
        </span>
      </summary>
      <p class="max-w-2xl pb-7 text-[0.9375rem] leading-relaxed text-muted">{item.answer}</p>
    </details>
  ))}
</div>

<style>
  summary:focus-visible {
    outline: 2px solid var(--c-accent);
    outline-offset: 4px;
    border-radius: 4px;
  }

  details[open] .faq-icon {
    transform: rotate(45deg);
  }

  .faq-icon {
    transition: transform 220ms var(--ease-out);
  }
</style>
