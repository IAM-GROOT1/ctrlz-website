---
/**
 * Light/dark switch. The current theme is applied by an inline script in
 * Base.astro before first paint; this only needs to render the icon and be
 * labelled correctly by that script.
 */
---

<button
  type="button"
  data-theme-toggle
  class="flex size-9 items-center justify-center rounded-md text-muted transition-colors hover:bg-surface hover:text-ink"
  aria-label="Switch to dark theme"
  aria-pressed="false"
>
  <svg
    viewBox="0 0 24 24"
    class="size-[18px] dark:hidden"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"></path>
  </svg>
  <svg
    viewBox="0 0 24 24"
    class="hidden size-[18px] dark:block"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"></path>
  </svg>
</button>
