---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  name: string;
  alt: string;
  label: string;
  width: number;
  height: number;
  theme?: string;
  priority?: boolean;
  sizes?: string;
  class?: string;
}

const {
  name,
  alt,
  label,
  width,
  height,
  theme = 'Light and dark',
  priority = false,
  sizes = '(min-width: 1024px) 640px, 100vw',
  class: className = '',
} = Astro.props;

// Drop real captures into src/assets/screenshots/<name>.png (or .webp/.avif)
// and the placeholder below disappears automatically.
const captures = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/screenshots/*.{png,jpg,jpeg,webp,avif}',
  { eager: true },
);

const capture = Object.entries(captures).find(([path]) => {
  const file = path.split('/').pop() ?? '';
  return file.replace(/\.[^.]+$/, '') === name;
})?.[1]?.default;

// Never request widths larger than the source: that only produces upscales.
const widths = capture
  ? [...new Set([480, 720, 960, 1180].filter((candidate) => candidate <= capture.width))]
  : [];
---

<figure class:list={['not-prose', className]}>
  <div class="frame">
    {capture ? (
      <Picture
        src={capture}
        alt={alt}
        widths={widths.length > 0 ? widths : undefined}
        sizes={sizes}
        formats={['avif', 'webp']}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'auto'}
        decoding="async"
        quality={82}
      />
    ) : (
      <div
        class="screenshot-placeholder"
        style={`aspect-ratio: ${width} / ${height}`}
        role="img"
        aria-label={`Placeholder for a screenshot: ${alt}`}
      >
        <span class="eyebrow">Screenshot slot</span>
        <span class="text-sm font-medium text-ink">{label}</span>
        <span class="mono text-xs text-muted">
          {width} × {height} · {theme}
        </span>
      </div>
    )}
  </div>
  {!capture && <figcaption class="sr-only">{alt}</figcaption>}
</figure>
