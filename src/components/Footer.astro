---
import { Image } from 'astro:assets';
import mark from '../assets/brand/mark-1024.png';
import { footerNav, footnote, site } from '../data/site';
import { buildLabel } from '../lib/build';

const year = new Date().getFullYear();
---

<footer class="border-t border-line">
  <div class="wrap grid gap-12 py-16 sm:grid-cols-2 md:grid-cols-[1.6fr_1fr_1fr]">
    <div class="max-w-xs">
      <a href="/" class="flex items-center gap-2.5" aria-label={`${site.name} — home`}>
        <Image
          src={mark}
          alt=""
          width={26}
          height={26}
          widths={[26, 52, 78]}
          sizes="26px"
          class="size-[26px] rounded-[6px]"
        />
        <span class="text-[0.9375rem] font-semibold">{site.name}</span>
      </a>
      <p class="mt-4 text-sm leading-relaxed text-muted">{site.tagline}</p>
      <p class="mono mt-3 text-muted">{site.domain}</p>
    </div>

    {footerNav.map((group) => (
      <div>
        <h2 class="eyebrow">{group.title}</h2>
        <ul class="mt-4 grid gap-2.5">
          {group.links.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-muted transition-colors hover:text-ink"
                {...('external' in link && link.external
                  ? { target: '_blank', rel: 'noopener noreferrer' }
                  : {})}
              >
                {link.label}
                {'external' in link && link.external ? (
                  <span class="sr-only"> (opens in a new tab)</span>
                ) : null}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  <div class="wrap flex flex-col gap-3 border-t border-line py-6 text-xs text-muted sm:flex-row sm:items-center sm:justify-between">
    <p>
      © {year} {site.name}
    </p>
    <p>
      <a class="link" href="/privacy">
        Privacy
      </a>
      <span aria-hidden="true"> · </span>
      {footnote.websiteLicense}
      <span aria-hidden="true"> · </span>
      <span class="mono">Site built {buildLabel}</span>
    </p>
  </div>

  <div class="wrap pb-10">
    <p class="max-w-2xl text-xs leading-relaxed text-muted">{footnote.independent}</p>
  </div>
</footer>
